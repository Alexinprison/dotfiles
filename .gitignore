# Credentials, private keys, and tokens must remain local.
.git-credentials
.netrc
.netrc.gpg
.claude-env

# Ignore environment files, but allow a public example template.
.env
.env.*
!.env.example
.bashrc.local
.gitconfig.local

# Track only the reviewed npm settings file; never add tokens to it.
.npmrc
!/npm/.npmrc

# Ignore SSH keys while allowing a public SSH configuration.
.ssh/*
!.ssh/config
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.pem
*.key
*.pfx
*.p12

# Ignore cloud credentials and private GPG data.
.aws/
.config/gcloud/
.azure/
.config/gh/hosts.yml
.gnupg/

# Ignore generated state, histories, and caches.
.wget-hsts
.bash_history
.zsh_history
.node_repl_history
.python_history

.lesshst
.viminfo
.DS_Store
__pycache__/
*.py[cod]

# Ignore editor backups and temporary swap files.
*~
*.swp
*.swo
